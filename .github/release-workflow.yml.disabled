name: Build and Release

on:
  push:
    tags:
      - "v*"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build-and-release:
    runs-on: windows-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
          cache: maven

      - name: Set up Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: npm
          cache-dependency-path: scanner/package-lock.json

      - name: Run Maven tests and package
        shell: pwsh
        run: mvn -B clean verify

      - name: Install scanner dependencies
        working-directory: scanner
        shell: pwsh
        run: npm ci

      - name: Validate scanner script syntax
        working-directory: scanner
        shell: pwsh
        run: node --check scan-page.js

      - name: Prepare release bundle
        shell: pwsh
        run: |
          $releaseName = "OAGP-$($env:GITHUB_REF_NAME)"
          $staging = Join-Path $env:RUNNER_TEMP $releaseName
          $bundle = Join-Path $env:RUNNER_TEMP "$releaseName.zip"

          New-Item -ItemType Directory -Force -Path $staging | Out-Null
          New-Item -ItemType Directory -Force -Path (Join-Path $staging "scanner") | Out-Null

          $jar = Get-ChildItem -Path target -Filter "*.jar" |
            Where-Object { $_.Name -notlike "original-*" } |
            Select-Object -First 1

          if (-not $jar) {
            throw "No executable jar found in target/."
          }

          Copy-Item $jar.FullName (Join-Path $staging "OAGP.jar")
          Copy-Item README.md (Join-Path $staging "README.md")
          Copy-Item scanner\scan-page.js (Join-Path $staging "scanner\scan-page.js")
          Copy-Item scanner\package.json (Join-Path $staging "scanner\package.json")
          Copy-Item scanner\package-lock.json (Join-Path $staging "scanner\package-lock.json")

          @(
            '@echo off',
            'setlocal',
            'cd /d %~dp0',
            'where node >nul 2>nul || (',
            '  echo Node.js is required to run OAGP.',
            '  exit /b 1',
            ')',
            'if not exist scanner\node_modules (',
            '  echo Installing scanner dependencies...',
            '  pushd scanner',
            '  call npm ci || exit /b 1',
            '  call npx playwright install chromium || exit /b 1',
            '  popd',
            ')',
            'java -jar OAGP.jar'
          ) | Set-Content -Encoding ASCII (Join-Path $staging "run-oagp.bat")

          @(
            'Set-Location $PSScriptRoot',
            'if (-not (Get-Command node -ErrorAction SilentlyContinue)) {',
            '  throw ''Node.js is required to run OAGP.''',
            '}',
            'if (-not (Test-Path .\scanner\node_modules)) {',
            '  Write-Host ''Installing scanner dependencies...''',
            '  Push-Location scanner',
            '  npm ci',
            '  npx playwright install chromium',
            '  Pop-Location',
            '}',
            'java -jar .\OAGP.jar'
          ) | Set-Content -Encoding ASCII (Join-Path $staging "run-oagp.ps1")

          if (Test-Path $bundle) {
            Remove-Item $bundle -Force
          }

          Compress-Archive -Path "$staging\*" -DestinationPath $bundle

          Add-Content -Path $env:GITHUB_ENV -Value "RELEASE_BUNDLE=$bundle"
          Add-Content -Path $env:GITHUB_ENV -Value "RELEASE_NAME=$releaseName"

      - name: Upload GitHub release
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ github.ref_name }}
          name: ${{ env.RELEASE_NAME }}
          files: ${{ env.RELEASE_BUNDLE }}
          generate_release_notes: true




