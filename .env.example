### OAGP .env - Example Environment Variables File to be used with Docker Compose
# Replace the placeholder values with your real API keys before running compose
# Do NOT commit real secrets to version control.

# Gemini (free-tier) API key used by default provider
GEMINI_API_KEY_FREE=

# Gemini (paid) API key (optional)
GEMINI_API_KEY_PAID=

# OpenAI API key (optional)
OPENAI_API_KEY=

# Playwright headless flag; set to "false" only if you need visible browser rendering
PLAYWRIGHT_HEADLESS=true

# JDBC URL for SQLite. Default keeps DB inside the named volume at /data
# Example for a host-mounted DB directory: jdbc:sqlite:/data/oagp_first.db
SPRING_DATASOURCE_URL=jdbc:sqlite:/data/oagp_first.db

